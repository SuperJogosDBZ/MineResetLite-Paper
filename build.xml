<project name="MineResetLite" default="build">
    <condition property="maven.executable" value="mvn.cmd" else="mvn">
        <os family="windows"/>
    </condition>
    <target name="build">
        <exec executable="${maven.executable}" failonerror="true">
            <arg value="clean"/>
            <arg value="verify"/>
        </exec>
    </target>
</project>
